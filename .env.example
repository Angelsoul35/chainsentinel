# ChainSentinel configuration (prefix CS_)
CS_ENVIRONMENT=local
CS_MODEL_DIR=artifacts
CS_STRUCTURING_THRESHOLD=10000     # reporting threshold; deposits just under it are a signal
CS_ALERT_THRESHOLD=0.5             # alert when the combined score is at or above this
# Report writing: "template" needs no LLM; "llm" uses the provider cascade.
CS_REPORT_MODE=template
CS_LLM_PROVIDERS=anthropic,openai,gemini,deepseek,ollama
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# DEEPSEEK_API_KEY=
# OLLAMA_HOST=http://localhost:11434
